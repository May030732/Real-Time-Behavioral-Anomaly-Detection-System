from ultralytics import YOLO
import cv2
import csv
import time
from pathlib import Path


# ==============================
# 基本設定
# ==============================

MODEL_PATH = "yolo11n-pose.pt"
CSV_OUTPUT_PATH = r"C:\Users\USER\Desktop\學校功課\專題\Real-Time-Behavioral-Anomaly-Detection-System-main\Real-Time-Behavioral-Anomaly-Detection-System-main\pose_test_CSV\test01.csv"

# 關鍵點最低信心度
CONFIDENCE_THRESHOLD = 0.5

# 內建相機編號
CAMERA_INDEX = 0


# ==============================
# 載入 YOLO11 Pose 模型
# ==============================

model = YOLO(MODEL_PATH)


# ==============================
# 開啟相機
# ==============================

cap = cv2.VideoCapture(CAMERA_INDEX, cv2.CAP_DSHOW)

if not cap.isOpened():
    print("無法開啟相機，請確認相機是否被其他程式占用。")
    raise SystemExit

print("Camera Open:", cap.isOpened())


# ==============================
# 定義要保留的 13 個關鍵點
# COCO Pose 關鍵點索引
# ==============================

WANTED_KEYPOINTS = [
    0,   # nose
    5,   # left_shoulder
    6,   # right_shoulder
    7,   # left_elbow
    8,   # right_elbow
    9,   # left_wrist
    10,  # right_wrist
    11,  # left_hip
    12,  # right_hip
    13,  # left_knee
    14,  # right_knee
    15,  # left_ankle
    16   # right_ankle
]


# 關鍵點名稱
KEYPOINT_NAMES = {
    0: "nose",
    5: "left_shoulder",
    6: "right_shoulder",
    7: "left_elbow",
    8: "right_elbow",
    9: "left_wrist",
    10: "right_wrist",
    11: "left_hip",
    12: "right_hip",
    13: "left_knee",
    14: "right_knee",
    15: "left_ankle",
    16: "right_ankle"
}


# ==============================
# 自訂骨架連線
# 格式：(點1, 點2, BGR顏色)
# ==============================

SKELETON_CONNECTIONS = [
    (0, 5, (0, 0, 255)),       # 頭到左肩
    (0, 6, (0, 0, 255)),       # 頭到右肩
    (5, 6, (255, 0, 0)),       # 左肩到右肩

    (5, 7, (255, 255, 0)),     # 左肩到左肘
    (7, 9, (255, 255, 0)),     # 左肘到左腕

    (6, 8, (0, 255, 0)),       # 右肩到右肘
    (8, 10, (0, 255, 0)),      # 右肘到右腕

    (5, 11, (0, 255, 0)),      # 左肩到左髖
    (6, 12, (0, 165, 255)),    # 右肩到右髖
    (11, 12, (255, 0, 0)),     # 左髖到右髖

    (11, 13, (0, 255, 0)),     # 左髖到左膝
    (13, 15, (0, 255, 0)),     # 左膝到左踝

    (12, 14, (0, 165, 255)),   # 右髖到右膝
    (14, 16, (0, 165, 255))    # 右膝到右踝
]


# ==============================
# 建立 CSV 欄位
# ==============================

csv_path = Path(CSV_OUTPUT_PATH)

csv_file = open(
    csv_path,
    mode="w",
    newline="",
    encoding="utf-8-sig"
)

csv_writer = csv.writer(csv_file)

header = [
    "frame",
    "time_sec",
    "person_id"
]

for kp_idx in WANTED_KEYPOINTS:
    kp_name = KEYPOINT_NAMES[kp_idx]

    header.extend([
        f"{kp_name}_x",
        f"{kp_name}_y",
        f"{kp_name}_conf"
    ])

csv_writer.writerow(header)
csv_file.flush()


# ==============================
# 執行偵測
# ==============================

frame_count = 0
start_time = time.perf_counter()

print("開始偵測。")
print("按 q 結束程式。")
print(f"CSV 將儲存於：{csv_path.resolve()}")


try:
    while True:
        ret, frame = cap.read()

        if not ret:
            print("讀不到影像。")
            break

        frame_count += 1

        # 使用程式執行時間作為即時 Webcam 的時間
        time_sec = time.perf_counter() - start_time

        # 執行 YOLO Pose 偵測
        results = model(
            frame,
            verbose=False
        )

        # 複製畫面，供自訂骨架繪製
        annotated = frame.copy()

        result = results[0]

        # 確保有偵測到人體關鍵點
        if (
            result.keypoints is not None
            and result.keypoints.data is not None
            and len(result.keypoints.data) > 0
        ):
            # 資料格式：
            # [偵測到的人數, 17個關鍵點, x/y/conf]
            keypoints_list = (
                result.keypoints.data
                .cpu()
                .numpy()
            )

            for person_id, person in enumerate(keypoints_list):
                # ==============================
                # 寫入 CSV
                # ==============================

                row = [
                    frame_count,
                    round(time_sec, 4),
                    person_id
                ]

                for kp_idx in WANTED_KEYPOINTS:
                    x, y, conf = person[kp_idx]

                    # 信心度過低時用空白表示，
                    # 避免把不可靠的 0 座標誤認為真實位置
                    if conf >= CONFIDENCE_THRESHOLD:
                        row.extend([
                            round(float(x), 2),
                            round(float(y), 2),
                            round(float(conf), 4)
                        ])
                    else:
                        row.extend([
                            "",
                            "",
                            round(float(conf), 4)
                        ])

                csv_writer.writerow(row)

                # ==============================
                # 畫出 13 個關鍵點
                # ==============================

                for kp_idx in WANTED_KEYPOINTS:
                    x, y, conf = person[kp_idx]

                    if conf >= CONFIDENCE_THRESHOLD:
                        point = (int(x), int(y))

                        # 橘色實心圓
                        cv2.circle(
                            annotated,
                            point,
                            6,
                            (0, 165, 255),
                            -1
                        )

                        # 標示關鍵點索引
                        cv2.putText(
                            annotated,
                            str(kp_idx),
                            (int(x) + 8, int(y) - 8),
                            cv2.FONT_HERSHEY_SIMPLEX,
                            0.5,
                            (255, 255, 255),
                            1,
                            cv2.LINE_AA
                        )

                # ==============================
                # 畫出骨架連線
                # ==============================

                for pt1_idx, pt2_idx, color in SKELETON_CONNECTIONS:
                    x1, y1, conf1 = person[pt1_idx]
                    x2, y2, conf2 = person[pt2_idx]

                    if (
                        conf1 >= CONFIDENCE_THRESHOLD
                        and conf2 >= CONFIDENCE_THRESHOLD
                    ):
                        cv2.line(
                            annotated,
                            (int(x1), int(y1)),
                            (int(x2), int(y2)),
                            color,
                            3
                        )

                # 在人物頭部附近標示 person_id
                nose_x, nose_y, nose_conf = person[0]

                if nose_conf >= CONFIDENCE_THRESHOLD:
                    cv2.putText(
                        annotated,
                        f"Person {person_id}",
                        (int(nose_x) - 30, int(nose_y) - 25),
                        cv2.FONT_HERSHEY_SIMPLEX,
                        0.6,
                        (255, 255, 255),
                        2,
                        cv2.LINE_AA
                    )

        # 每幀結束後立即寫入硬碟
        csv_file.flush()

        # 顯示畫面資訊
        cv2.putText(
            annotated,
            f"Frame: {frame_count}",
            (15, 30),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (255, 255, 255),
            2,
            cv2.LINE_AA
        )

        cv2.putText(
            annotated,
            f"Time: {time_sec:.2f} sec",
            (15, 60),
            cv2.FONT_HERSHEY_SIMPLEX,
            0.7,
            (255, 255, 255),
            2,
            cv2.LINE_AA
        )

        cv2.imshow(
            "YOLO11 Custom 13-Pose",
            annotated
        )

        # 按 q 結束
        key = cv2.waitKey(1) & 0xFF

        if key == ord("q"):
            print("使用者按下 q，結束偵測。")
            break


except KeyboardInterrupt:
    print("\n偵測已由使用者中斷。")


finally:
    # ==============================
    # 釋放資源
    # ==============================

    csv_file.close()
    cap.release()
    cv2.destroyAllWindows()

    print("程式已結束。")
    print(f"總幀數：{frame_count}")
    print(f"CSV 已儲存於：{csv_path.resolve()}")
